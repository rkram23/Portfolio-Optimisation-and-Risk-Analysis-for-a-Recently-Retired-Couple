k    <- ncol(Sigma)
Amat <- matrix(1, k, 1); bvec <- 1; meq <- 1
if (!is.null(target)) { Amat <- cbind(Amat, mu); bvec <- c(bvec, target); meq <- 2 }
Amat <- cbind(Amat, diag(k)); bvec <- c(bvec, rep(0, k))
if (cap < 1) { Amat <- cbind(Amat, -diag(k)); bvec <- c(bvec, rep(-cap, k)) }
if (is.null(lambda)) { D <- 2 * Sigma; dv <- rep(0, k) } else { D <- lambda * Sigma; dv <- mu }
w <- solve.QP(D, dv, Amat, bvec, meq = meq)$solution
w[abs(w) < 1e-8] <- 0
setNames(w / sum(w), colnames(Sigma))
}
# Performance of fixed weights, rebalanced monthly
port_stats <- function(w, R, rf) {
rp     <- as.numeric(R %*% w)
ex     <- rp - rf
wealth <- cumprod(1 + rp)
c(Mean_pct        = 100 * mean(rp),
SD_pct          = 100 * sd(rp),
Sharpe          = mean(ex) / sd(ex),
Ann_Mean_pct    = 1200 * mean(rp),
Ann_SD_pct      = 100 * sqrt(12) * sd(rp),
Ann_Sharpe      = sqrt(12) * mean(ex) / sd(ex),
Cumulative_pct  = 100 * (prod(1 + rp) - 1),
Worst_month_pct = 100 * min(rp),
Max_DD_pct      = 100 * min(wealth / cummax(wealth) - 1),
HHI             = sum(w^2),
Effective_N     = 1 / sum(w^2))
}
stats_table <- function(ports, R, rf) t(sapply(ports, port_stats, R = R, rf = rf))
port_cols <- c("Mean_pct", "SD_pct", "Sharpe", "Ann_Mean_pct", "Ann_SD_pct", "Ann_Sharpe",
"Worst_month_pct", "Max_DD_pct", "HHI", "Effective_N")
port_digits <- c(2, 2, 3, 1, 1, 2, 1, 1, 3, 1)
# Formatting helpers for numbers quoted in the text
fmt <- function(x, d = 2) formatC(as.numeric(x), format = "f", digits = d)
fp  <- function(p) if (p < 0.001) "< 0.001" else formatC(p, format = "f", digits = 3)
lst <- function(x) if (length(x) == 0) "none" else paste(x, collapse = ", ")
ex_est   <- Rm - rf_vec
mean_m   <- colMeans(Rm)
sd_m     <- apply(Rm, 2, sd)
sharpe_m <- colMeans(ex_est) / apply(ex_est, 2, sd)
geo_m    <- apply(1 + Rm, 2, prod)^(1 / nrow(Rm)) - 1
worst_m  <- apply(Rm, 2, min)
max_dd   <- apply(Rm, 2, function(r) { w <- cumprod(1 + r); min(w / cummax(w) - 1) })
a1_monthly <- data.frame(Ticker       = tickers,
Mean_pct     = 100 * mean_m,
Geo_mean_pct = 100 * geo_m,
SD_pct       = 100 * sd_m,
Sharpe       = sharpe_m)
kable(a1_monthly[order(-a1_monthly$Sharpe), ], digits = c(0, 2, 2, 2, 3), row.names = FALSE,
caption = "Table A1.1: Monthly return, volatility and Sharpe ratio (estimation sample, ranked by Sharpe)")
a1_annual <- data.frame(Ticker           = tickers,
Ann_Mean_pct     = 1200 * mean_m,
Ann_SD_pct       = 100 * sqrt(12) * sd_m,
Ann_Sharpe       = sqrt(12) * sharpe_m,
Worst_month_pct  = 100 * worst_m,
Max_drawdown_pct = 100 * max_dd)
kable(a1_annual[order(-a1_annual$Ann_Sharpe), ], digits = c(0, 1, 1, 2, 1, 1), row.names = FALSE,
caption = "Table A1.2: Annualised measures and downside risk (estimation sample)")
plot_df <- data.frame(Ticker = tickers, SD = 100 * sd_m, Mean = 100 * mean_m, Sharpe = sharpe_m)
ggplot(plot_df, aes(SD, Mean)) +
geom_smooth(method = "lm", formula = y ~ x, se = FALSE, linetype = "dashed", colour = "grey50") +
geom_smooth(data = subset(plot_df, Ticker != "ELA"), method = "lm", formula = y ~ x, se = FALSE,
linetype = "dotted", colour = "steelblue", linewidth = 1) +
geom_point(aes(colour = Sharpe), size = 3.5) +
geom_text(aes(label = Ticker), vjust = -1, size = 3.2) +
scale_colour_gradient(low = "firebrick", high = "darkgreen") +
scale_y_continuous(expand = expansion(mult = c(0.05, 0.12))) +
labs(x = "Volatility (monthly standard deviation, %)", y = "Average monthly return (%)",
colour = "Sharpe ratio\n(monthly)",
caption = "Dashed grey: trend for all 10 stocks. Dotted blue: trend excluding ELA.") +
theme_minimal()
cor.test(plot_df$SD, plot_df$Mean)
with(subset(plot_df, Ticker != "ELA"), cor.test(SD, Mean))
extremes <- function(tk) {
d <- data.frame(Ticker = tk, Month = format(index(R_est)), Return_pct = 100 * Rm[, tk])
d <- d[order(d$Return_pct), ]
rbind(head(d, 2), tail(d, 2))
}
